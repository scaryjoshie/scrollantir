# macOS
.DS_Store

# Python (future: mac-forwarder, server)
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Admin CLI local config (contains service_role DSN)
scripts/.env.admin

# Local secrets inbox (minted tokens, DSNs — never commit)
scripts/.secrets/

# Per-user Claude Code overrides (bypass perms etc.) — never commit
.claude/settings.local.json

# Node (future: dashboard)
node_modules/

# IDE
.vscode/
.idea/
*.iml

# Build artifacts
build/
dist/
*.log

# Vendored reference code — clone locally, don't commit
vendor/

# Secrets / local config — never commit
secrets/
*.local
local.properties
