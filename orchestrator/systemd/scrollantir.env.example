# /etc/scrollantir.env — secrets for the orchestrator container.
#
# Install on the VM as:
#   sudo install -m 600 -o root -g root this-file /etc/scrollantir.env
#   sudo $EDITOR /etc/scrollantir.env   # fill in the real values
#
# Do NOT commit a filled-in copy. This example lives in the repo;
# the real file never leaves the VM (and Keychain + scripts/.secrets/
# on your Mac).

# One of the two Anthropic auth vars must be set. Either works;
# entrypoint.sh propagates whichever is present into the crontab env.
#
# Preferred: long-lived subscription token from `claude setup-token`
# on your Mac. Uses your existing Claude Max plan, no per-token billing.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-REPLACE_ME

# Alternative: raw API key from console.anthropic.com. Pay-per-token.
# ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# agent_role DSN. On your Mac this is in Keychain at scrollantir/agent-role;
# retrieve with:
#   security find-generic-password -s scrollantir -a agent-role -w
AGENT_DATABASE_URL=postgresql://agent_role.PROJECT:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
