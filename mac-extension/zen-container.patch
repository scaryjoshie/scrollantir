+// scrollantir zen fork: resolve a Firefox Container's name from its
+// cookieStoreId. Josh uses one container per Zen workspace, so container
+// name == workspace name. Returns 'no-container' for the default store
+// or when resolution fails (identity deleted, non-Firefox, etc).
+const CONTAINER_NAME_CACHE = new Map<string, string>()
+async function resolveContainerName(
+  cookieStoreId: string | undefined,
+): Promise<string> {
+  if (!cookieStoreId || cookieStoreId === 'firefox-default') {
+    return 'no-container'
+  }
+  const cached = CONTAINER_NAME_CACHE.get(cookieStoreId)
+  if (cached !== undefined) return cached
+  // `contextualIdentities` is Firefox-only. Guard so Chrome/Safari builds
+  // don't throw on missing API — they just won't have this field.
+  const api = (browser as any).contextualIdentities
+  if (!api || typeof api.get !== 'function') return 'no-container'
+  try {
+    const identity = await api.get(cookieStoreId)
+    const name = identity?.name ?? 'no-container'
+    CONTAINER_NAME_CACHE.set(cookieStoreId, name)
+    return name
+  } catch {
+    return 'no-container'
+  }
+}
+
 async function heartbeat(
   client: AWClient,
   tab: browser.Tabs.Tab | undefined,
