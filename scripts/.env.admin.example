# Scrollantir admin CLI configuration.
#
# Copy this file to scripts/.env.admin (which is gitignored) and paste
# the service_role direct-connection string from the Supabase dashboard:
#
#   Settings -> Database -> Connection string -> psql
#
# NOT the session pooler. The CLI runs ALTER ROLE and expects a
# direct-connection URL whose host is db.<project-ref>.supabase.co so
# the project ref can be extracted for the QR payload.
#
# Alternative: export SCROLLANTIR_ADMIN_DATABASE_URL in your shell
# instead of using this file. The env var takes precedence.

DATABASE_URL=postgresql://postgres:SERVICE_ROLE_PASSWORD@db.feijpewzqgqczkxmvdng.supabase.co:5432/postgres
