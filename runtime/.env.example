# scrollantir runtime — environment variables.
# Copy to .env and fill in. .env is gitignored.

# ── Postgres superuser (data plane bootstrap) ──────────────────────
# POSTGRES_PASSWORD is the only one that genuinely matters as a secret —
# the superuser DSN never leaves the Docker network.
POSTGRES_USER=scrollantir
POSTGRES_PASSWORD=
POSTGRES_DB=scrollantir

# ── Role passwords (used by db/schemas/20_roles.sh on first boot) ──
# Generate fresh strong values. Never commit. PostgREST connects as
# `authenticator`; `agent_role` is what the agent container uses.
AUTHENTICATOR_PW=
USER_PW=
AGENT_PW=

# ── Caddy / public hostname ────────────────────────────────────────
# Local dev: leave unset; Caddy serves HTTP on :80 only.
# Production: set to the public hostname so Caddy auto-provisions a
# Let's Encrypt cert and redirects HTTP → HTTPS.
# INGEST_HOSTNAME=ingest.178-104-253-30.nip.io
# ACME_EMAIL=you@example.com

# ── Reserved (populated in later commits) ──────────────────────────
# JWT_SECRET=                   # if/when Path B (JWT) auth ships
# CLAUDE_CODE_OAUTH_TOKEN=      # for the agent's `claude -p` jobs
