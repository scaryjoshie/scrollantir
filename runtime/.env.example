# scrollantir runtime — environment variables.
# Copy to .env and fill in. .env is gitignored.

# Postgres (data plane). POSTGRES_PASSWORD is the only required value.
POSTGRES_USER=scrollantir
POSTGRES_PASSWORD=
POSTGRES_DB=scrollantir

# Reserved — populated when db/schemas/ ports happen and PostgREST gets a
# proper authenticator + anon role split. Path A (RPC bearer-token auth)
# keeps these unused for v0.
# AUTHENTICATOR_PW=
# JWT_SECRET=

# Reserved — populated when the agent shells out to `claude -p` and
# connects to its own DB role. Not used in commit #1's tick stub.
# CLAUDE_CODE_OAUTH_TOKEN=
# AGENT_DATABASE_URL=
