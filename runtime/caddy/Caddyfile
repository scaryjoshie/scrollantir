# scrollantir runtime — Caddy config.
#
# Hostname is env-driven via the caddy container's INGEST_HOSTNAME var:
#
#   Local dev:  unset → defaults to ":80" (HTTP only, no ACME)
#   Hetzner:    set to "ingest.178-104-253-30.nip.io" or similar →
#               Caddy auto-provisions Let's Encrypt cert and redirects
#               HTTP → HTTPS automatically.
#
# ACME_EMAIL is optional but recommended in prod for Let's Encrypt
# expiry notifications.

{$INGEST_HOSTNAME::80} {
	# zstd > brotli > gzip — Caddy negotiates by Accept-Encoding.
	# Cheapest cross-Atlantic latency fix: 156KB JSON → ~20KB.
	# Real fix is reducing data volume (slim view + chunk coalesce);
	# this is the floor.
	encode zstd gzip

	handle /health {
		reverse_proxy api:8000
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy postgrest:3000
	}
}

# Dashboard (read-only PostgREST as user_role, basic-auth gated).
# Local dev: leave DASHBOARD_HOSTNAME unset → block listens on
# container port :9999 (not mapped to host = unreachable).
# Production: set DASHBOARD_HOSTNAME=dashboard.<your>.nip.io →
# Caddy auto-ACMEs and basic_auth gates every request.
{$DASHBOARD_HOSTNAME::9999} {
	encode zstd gzip

	basic_auth {
		josh {$DASHBOARD_BCRYPT}
	}
	reverse_proxy postgrest-dashboard:3000
}
