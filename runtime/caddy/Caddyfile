# scrollantir runtime — Caddy config.
#
# Hostname is env-driven via the caddy container's INGEST_HOSTNAME var:
#
#   Local dev:  unset → defaults to ":80" (HTTP only, no ACME)
#   Hetzner:    set to "ingest.178-104-253-30.nip.io" or similar →
#               Caddy auto-provisions Let's Encrypt cert and redirects
#               HTTP → HTTPS automatically.
#
# ACME_EMAIL is optional but recommended in prod for Let's Encrypt
# expiry notifications.

{$INGEST_HOSTNAME::80} {
	handle /health {
		reverse_proxy api:8000
	}

	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy postgrest:3000
	}
}
